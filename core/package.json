{
  "name": "@tessera/core",
  "version": "0.1.0",
  "description": "Pure TypeScript core logic for the Tessera puzzle — types, PRNG, solver, generator, codec",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx scripts/bench.ts",
    "gen-vectors": "tsx scripts/gen-vectors.ts",
    "stats": "tsx scripts/stats.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
